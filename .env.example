# Copy to .env for local runs that should use Neon instead of local PGlite.
# Local runs without DATABASE_URL use PGlite (./data/pglite) — no account needed.
# Production (Render): set DATABASE_URL in the Render dashboard, never in git.
# Neon pooled connection string, e.g.:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=
# Render sets PORT itself; local default is 3000.
PORT=3000

# Live Stripe payments (real money). Leave blank for test mode — the Store
# then uses the 4242 test card only, no real charge.
# To go live, Al adds the LIVE secret key himself in the Render dashboard:
# service cfnb-cutthroat > Environment > add STRIPE_SECRET_KEY, value is
# the key starting sk_live_ from his existing LightWorks Stripe account
# (Stripe Dashboard > Developers > API keys). NEVER put a real key in
# this file, in chat, or in the repo. No publishable key is needed — the
# game never calls Stripe from the browser; checkout is hosted by Stripe.
# STRIPE_SECRET_KEY=sk_live_...
