# Copy to .env for local runs that should use Neon instead of local PGlite.
# Local runs without DATABASE_URL use PGlite (./data/pglite) — no account needed.
# Production (Render): set DATABASE_URL in the Render dashboard, never in git.
# Neon pooled connection string, e.g.:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=
# Render sets PORT itself; local default is 3000.
PORT=3000
